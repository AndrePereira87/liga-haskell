cabal-version:      2.4
name:               liga-haskell
version:            0.1.0.0
synopsis:           Sistema de Gestao de Liga Desportiva e Torneios em Haskell
build-type:         Simple

executable liga-haskell
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:    Model, Domain
  build-depends:    base >=4.14 && <5
  default-language: Haskell2010
  ghc-options:      -Wall

test-suite liga-haskell-tests
  type:             exitcode-stdio-1.0
  main-is:          TestMain.hs
  hs-source-dirs:   test, src
  other-modules:    Model, Domain
  build-depends:    base >=4.14 && <5
  default-language: Haskell2010
  ghc-options:      -Wall
